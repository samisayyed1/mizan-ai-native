# Mizan — environment template. Copy to .env and fill in values.
# .env is gitignored; never commit secrets.

# Local SQLite database path (used by Tauri / web server).
DATABASE_URL=../db/app.db

# ---------------------------------------------------------------------------
# Mizan Connect (optional — leave empty to ship an offline-only build)
# ---------------------------------------------------------------------------
# When CONNECT_AUTH_URL or CONNECT_AUTH_PUBLISHABLE_KEY is empty, the
# CONNECT_ENABLED feature flag becomes false at build time and every
# Connect-related UI surface stays hidden. The app runs fully local.

# Supabase project URL (public). Example: https://xxxxx.supabase.co
CONNECT_AUTH_URL=

# Supabase publishable (anon) key — never the service_role secret.
CONNECT_AUTH_PUBLISHABLE_KEY=

# Mizan Connect backend base URL.
#   Dev:  http://localhost:8080
#   Prod: https://mizan-connect.fly.dev
# The desktop's "Mizan AI" provider (default for new installs) proxies
# its LLM calls through this URL with the user's Supabase JWT as
# Bearer. Without this set, Mizan AI fails with "Mizan Connect not
# configured" and the AddAssetDialog surfaces the Sign-in CTA.
CONNECT_API_URL=

# OAuth bounce-page URL for the desktop's Google / Apple / GitHub sign-in
# flow. Google's identity platform rejects the bare `mizan://` custom
# scheme (`redirect_uri_mismatch`), so the desktop OAuth flow targets
# this HTTPS page on the Connect cloud (served by
# `crates/connect/src/auth_bounce.rs`), which immediately rebroadcasts
# the auth `code` + `state` into `mizan://auth/callback?<query>` for
# the desktop's deep-link listener to pick up. Both dev and prod
# desktop builds use this URL.
#
#   Dev / Prod desktop: https://mizan-connect.fly.dev/auth/callback
#   Self-hosted Connect: https://<your-connect-domain>/auth/callback
CONNECT_OAUTH_CALLBACK_URL=https://mizan-connect.fly.dev/auth/callback

# ---------------------------------------------------------------------------
# Anthropic API key (optional — only needed if the user brings their own
# key instead of using the Mizan-managed AI path through Connect).
# Get one: https://console.anthropic.com/settings/keys
# Stored encrypted in the local SQLite by the desktop; the in-process Rust
# code never logs it.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Sentry (desktop crash reporting). Optional.
# When empty, Sentry is fully disabled — no network calls, no PII risk.
# Frontend: VITE_SENTRY_DSN — propagated at build time.
# Rust core: SENTRY_DSN — read at runtime.
# Both should point to the SAME Sentry project but use the project's
# corresponding DSN format.
# ---------------------------------------------------------------------------
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Addon store endpoint. Optional — defaults to https://mizan.app/api/addons.
# Operators running a self-hosted / enterprise addon catalog can point
# the desktop at their own store via this env var without rebuilding.
# Resolved at call time, so a process restart is enough to switch
# targets.
# ---------------------------------------------------------------------------
# MIZAN_ADDON_STORE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Production guard. The PreToolUse hook in .claude/settings.json blocks
# fly deploy / stripe live / git push / gh pr merge unless this is set
# to "1". Local dev never needs to set this — it's intentional friction
# against accidental production actions.
# ---------------------------------------------------------------------------
# MIZAN_ALLOW_PRODUCTION=
