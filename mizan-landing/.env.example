# Supabase — server-side only; the service role can bypass RLS so it
# must NEVER leak to the client. The Next.js route reads SUPABASE_URL
# + SUPABASE_SERVICE_ROLE directly via process.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE=

# Public Supabase keys are not currently used (no client reads), but
# kept here so a future client-side feature doesn't accidentally pull
# the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — confirmation email. When unset, the lib falls back to a
# no-op stub so dev + preview branches still work.
RESEND_API_KEY=
RESEND_FROM="Mizan <info@getmizan.net>"
# Resend Audience (mailing list) ID. When set, every signup is added
# to this audience so you can send a launch broadcast. Find it at
# resend.com/audiences. Optional — Supabase is the source of truth.
RESEND_AUDIENCE_ID=

# Upstash Redis — rate limit backend. When unset, the lib uses an
# in-process Map. Production must set both.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL, used in OG image route, invite link rendering,
# canonical metadata, and the email template.
NEXT_PUBLIC_SITE_URL=https://getmizan.net

# Plausible analytics — when unset, the layout script doesn't render
# and the server-side custom-event fire is skipped.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=getmizan.net
