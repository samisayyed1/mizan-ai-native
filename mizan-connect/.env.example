# Mizan Connect — environment configuration template.
# Copy to .env and fill in values for local development.
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# development | staging | production | test
APP_ENV=development

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# pretty | json   (use json in staging/production)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://mizan:mizan@localhost:5433/mizan_connect
DATABASE_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Supabase (identity provider)
#   - SUPABASE_URL is the public project URL, e.g. https://xxxxx.supabase.co
#   - JWKS is fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   - SUPABASE_JWT_AUDIENCE is "authenticated" for end-user tokens.
#   - Service role secret is NOT needed for Chunk 1; left blank intentionally.
#     Will be required in Chunks 2-4 for server-to-server admin operations.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins.
# Wildcard "*" is rejected at startup when auth endpoints exist.
# ---------------------------------------------------------------------------
MIZAN_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost

# ---------------------------------------------------------------------------
# Rate limiting (per IP, per minute)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# Sentry (optional). Leaving SENTRY_DSN empty disables Sentry entirely.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Plaid Gold live sync
#   Plaid Link uses a short-lived link_token from the server. The frontend sends
#   only the resulting public_token back; access_token stays encrypted here.
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
PLAID_API_BASE=
PLAID_REDIRECT_URI=http://localhost:1420/connect/plaid-return
PLAID_WEBHOOK_URL=http://localhost:8080/api/v1/sync/plaid/webhook

# AES-256-GCM key for encrypting Plaid access tokens in Postgres.
# Decoded length must be exactly 32 bytes. Generate with:
#   openssl rand -base64 32
MIZAN_PLAID_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Stripe billing
#   STRIPE_SECRET_KEY: sk_test_… for staging, sk_live_… in prod. Never commit.
#   STRIPE_WEBHOOK_SECRET: whsec_… copied from the Stripe Dashboard webhook.
#   Price IDs: create Silver and Gold Prices. Legacy Basic/Pro/Enterprise env
#   names are still accepted during migration, but the product exposes only
#   silver and gold.
#   MIZAN_BILLING_RETURN_URL: where Stripe redirects after Checkout/Portal;
#   the desktop's auth-callback page handles this URL.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_SILVER_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
MIZAN_BILLING_RETURN_URL=mizan://billing/return

# ---------------------------------------------------------------------------
# Managed AI proxy (Chunk 4)
#   OPENAI_API_KEY: server-owned key used by /v1/ai/chat. The desktop never
#   sees it — clients authenticate to us with their JWT, we authenticate to
#   OpenAI with this key. Charge-on-success: see crates/ai_proxy + ledger.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Test-only — must be empty in production. Production builds reject this
# code path even if the variable is set.
# ---------------------------------------------------------------------------
MIZAN_TEST_JWT_SECRET=
