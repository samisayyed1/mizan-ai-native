# Mizan Connect — environment configuration template.
# Copy to .env and fill in values for local development.
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8080
# development | staging | production | test
APP_ENV=development

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# pretty | json   (use json in staging/production)
LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://mizan:mizan@localhost:5433/mizan_connect
DATABASE_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Supabase (identity provider)
#   - SUPABASE_URL is the public project URL, e.g. https://xxxxx.supabase.co
#   - JWKS is fetched from {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   - SUPABASE_JWT_AUDIENCE is "authenticated" for end-user tokens.
#   - Service role secret is NOT needed for Chunk 1; left blank intentionally.
#     Will be required in Chunks 2-4 for server-to-server admin operations.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins.
# Wildcard "*" is rejected at startup when auth endpoints exist.
# ---------------------------------------------------------------------------
MIZAN_CORS_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost

# ---------------------------------------------------------------------------
# Rate limiting (per IP, per minute)
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# Sentry (optional). Leaving SENTRY_DSN empty disables Sentry entirely.
# ---------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Plaid Gold live sync
#   Plaid Link uses a short-lived link_token from the server. The frontend sends
#   only the resulting public_token back; access_token stays encrypted here.
# ---------------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | development | production
PLAID_ENV=sandbox
PLAID_API_BASE=
PLAID_REDIRECT_URI=http://localhost:1420/connect/plaid-return
PLAID_WEBHOOK_URL=http://localhost:8080/api/v1/sync/plaid/webhook

# AES-256-GCM key for encrypting Plaid access tokens in Postgres.
# Decoded length must be exactly 32 bytes. Generate with:
#   openssl rand -base64 32
MIZAN_PLAID_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Stripe billing
#   STRIPE_SECRET_KEY: sk_test_… for staging, sk_live_… in prod. Never commit.
#   STRIPE_WEBHOOK_SECRET: whsec_… copied from the Stripe Dashboard webhook.
#   Price IDs: create Silver and Gold Prices. Legacy Basic/Pro/Enterprise env
#   names are still accepted during migration, but the product exposes only
#   silver and gold.
#   MIZAN_BILLING_RETURN_URL: where Stripe redirects after Checkout/Portal;
#   the desktop's auth-callback page handles this URL.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_SILVER_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=
MIZAN_BILLING_RETURN_URL=mizan://billing/return

# ---------------------------------------------------------------------------
# Managed AI proxy (Chunk 4)
#   OPENAI_API_KEY: server-owned key used by /v1/ai/chat. The desktop never
#   sees it — clients authenticate to us with their JWT, we authenticate to
#   OpenAI with this key. Charge-on-success: see crates/ai_proxy + ledger.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# SnapTrade Gold broker sync
#   SnapTrade has no separate sandbox host — sandbox keys hit api.snaptrade.com
#   directly. The difference is the connection limit (~5) and that some
#   institutions return mock data only.
# ---------------------------------------------------------------------------
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# sandbox | production
SNAPTRADE_ENV=sandbox
SNAPTRADE_API_BASE=https://api.snaptrade.com/api/v1
SNAPTRADE_REDIRECT_URI=http://localhost:1420/connect/snaptrade-return
SNAPTRADE_WEBHOOK_SECRET=

# AES-256-GCM key for encrypting SnapTrade userSecret at rest.
# Decoded length must be exactly 32 bytes. openssl rand -base64 32
MIZAN_BROKER_SECRET_ENCRYPTION_KEY=

# HS256 secret for SnapTrade state-token JWT (10-min TTL).
# Decoded length must be >= 32 bytes.
MIZAN_SNAPTRADE_STATE_SECRET=

# ---------------------------------------------------------------------------
# Managed AI — additional providers + safety flags
# ---------------------------------------------------------------------------
# Anthropic upstream (post-Phase B). Leave empty until live.
ANTHROPIC_API_KEY=
# stateless: proxy never persists prompts or completions.
AI_PROXY_MODE=stateless
# Never set to true in production. Used only for local dev debugging.
AI_LOG_PROMPTS=false
AI_LOG_FINANCIAL_PAYLOADS=false

# ---------------------------------------------------------------------------
# Stripe checkout / portal redirect URLs (optional overrides — defaults
# resolve to MIZAN_BILLING_RETURN_URL)
# ---------------------------------------------------------------------------
STRIPE_CUSTOMER_PORTAL_RETURN_URL=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# ---------------------------------------------------------------------------
# Supabase JWT verification (alternative to JWKS for service-role tokens).
# Leave SUPABASE_JWT_SECRET empty in production — prefer JWKS.
# ---------------------------------------------------------------------------
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Public app URL — used to build invite redeem URLs and Stripe redirects.
#   Dev: http://localhost:1420
#   Prod: https://app.mizan.app
# ---------------------------------------------------------------------------
APP_PUBLIC_URL=http://localhost:1420

# ---------------------------------------------------------------------------
# Admin surface — leave EMPTY to disable /v1/admin/* entirely (returns 503).
# When set, every admin endpoint requires `Authorization: Bearer <token>`
# constant-time matched against this value. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
MIZAN_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# News (NewsAPI free developer tier). Optional — without a key the news
# handler returns an empty list with a deliberate "news temporarily
# unavailable" payload rather than crashing.
# Sign up: https://newsapi.org/register
# ---------------------------------------------------------------------------
MIZAN_NEWSAPI_KEY=

# ---------------------------------------------------------------------------
# Precious-metals spot prices (MetalpriceAPI free tier).
# Sign up: https://metalpriceapi.com (50 req/month free).
# Used by the Zakat engine to compute Nisab thresholds at current spot.
# Cached per CLAUDE.md §18.3 (1-hour TTL for commodities).
# ---------------------------------------------------------------------------
METALPRICEAPI_KEY=

# ---------------------------------------------------------------------------
# Equities live feed (Twelve Data free tier).
# Sign up: https://twelvedata.com (8 req/min, 800/day free).
# Feeds the dashboard heatmap and per-symbol live quotes; falls back to
# last-known price with a "last updated" indicator when unreachable.
# ---------------------------------------------------------------------------
TWELVE_DATA_API_KEY=

# ---------------------------------------------------------------------------
# Email (Resend). Optional; leaving empty disables outbound email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# ---------------------------------------------------------------------------
# Forward-looking OAuth-framework encryption keys (Track J PR-J1+).
# These are not yet wired into handlers but the schema migration is on
# main, so the keys are documented here for when the handlers ship.
# Each must decode to exactly 32 bytes. Generate with:
#   openssl rand -hex 32
# Leave empty until the corresponding integration goes live.
# ---------------------------------------------------------------------------
SETU_TOKEN_ENCRYPTION_KEY=
SGFINDEX_TOKEN_ENCRYPTION_KEY=
TINK_TOKEN_ENCRYPTION_KEY=
BASIQ_TOKEN_ENCRYPTION_KEY=
LEAN_TOKEN_ENCRYPTION_KEY=
CCXT_API_KEY_ENCRYPTION_KEY=
MCP_TOKEN_ENCRYPTION_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
REDACT_LOGS=true

# ---------------------------------------------------------------------------
# Test-only — must be empty in production. Production builds reject this
# code path even if the variable is set.
# ---------------------------------------------------------------------------
MIZAN_TEST_JWT_SECRET=
